{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "tags": ["gpu", "dcgm", "sre"],
  "title": "GPU Utilization vs Allocation",
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "10s",
  "templating": { "list": [] },
  "panels": [
    {
      "type": "timeseries",
      "title": "The gap: GPU_UTIL vs real engine activity",
      "description": "GPU_UTIL only means a kernel was running. GR_ENGINE_ACTIVE and TENSOR_ACTIVE are the real work. A wide gap = the card looks busy but is underused.",
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "min": 0, "max": 1, "custom": { "fillOpacity": 10, "lineWidth": 2 } }
      },
      "targets": [
        { "expr": "DCGM_FI_DEV_GPU_UTIL / 100", "legendFormat": "GPU_UTIL (kernel active)", "refId": "A" },
        { "expr": "DCGM_FI_PROF_GR_ENGINE_ACTIVE", "legendFormat": "GR_ENGINE_ACTIVE (real compute)", "refId": "B" },
        { "expr": "DCGM_FI_PROF_PIPE_TENSOR_ACTIVE", "legendFormat": "TENSOR_ACTIVE (tensor cores)", "refId": "C" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Framebuffer memory (allocation proxy)",
      "description": "Memory in use means a workload is resident. Memory high + engine activity low = allocated-but-idle.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 9 },
      "fieldConfig": { "defaults": { "unit": "decmbytes" } },
      "targets": [
        { "expr": "DCGM_FI_DEV_FB_USED", "legendFormat": "FB used (MiB)", "refId": "A" },
        { "expr": "DCGM_FI_DEV_FB_FREE", "legendFormat": "FB free (MiB)", "refId": "B" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Memory bandwidth activity",
      "description": "DRAM_ACTIVE shows whether the workload is memory-bound vs compute-bound.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 9 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 } },
      "targets": [
        { "expr": "DCGM_FI_PROF_DRAM_ACTIVE", "legendFormat": "DRAM_ACTIVE", "refId": "A" }
      ]
    },
    {
      "type": "stat",
      "title": "Allocated but idle (GPUs)",
      "description": "Count of GPUs holding memory while engines are <5% active. This is the cost signal.",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 17 },
      "fieldConfig": {
        "defaults": {
          "thresholds": { "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 1 } ] }
        }
      },
      "targets": [
        { "expr": "count((DCGM_FI_DEV_FB_USED > 1024) and (avg_over_time(DCGM_FI_PROF_GR_ENGINE_ACTIVE[15m]) < 0.05)) or vector(0)", "refId": "A" }
      ]
    },
    {
      "type": "timeseries",
      "title": "vLLM: KV-cache usage & queue depth",
      "description": "KV-cache grows with concurrency and context length - a common OOM path. Queue depth shows batching pressure.",
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 17 },
      "fieldConfig": { "defaults": {} },
      "targets": [
        { "expr": "vllm:gpu_cache_usage_perc", "legendFormat": "KV-cache usage", "refId": "A" },
        { "expr": "vllm:num_requests_running", "legendFormat": "running", "refId": "B" },
        { "expr": "vllm:num_requests_waiting", "legendFormat": "waiting", "refId": "C" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Power & temperature",
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 17 },
      "fieldConfig": { "defaults": {} },
      "targets": [
        { "expr": "DCGM_FI_DEV_POWER_USAGE", "legendFormat": "power (W)", "refId": "A" },
        { "expr": "DCGM_FI_DEV_GPU_TEMP", "legendFormat": "temp (C)", "refId": "B" }
      ]
    }
  ]
}
